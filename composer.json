{
    "name": "salines/cakephp4-soft-delete",
    "description": "SoftDelete plugin for CakePHP 5 (fork of salines/cakephp4-soft-delete, kept under the original package name)",
    "keywords": ["cakephp", "cakephp 5", "plugin", "soft", "delete", "deletable"],
    "homepage": "https://github.com/chcnetconsulting/cakephp4-soft-delete",
    "type": "cakephp-plugin",
    "license": "MIT",
    "support": {
        "source": "https://github.com/chcnetconsulting/cakephp4-soft-delete"
    },
    "require": {
        "php": ">=8.1",
        "cakephp/plugin-installer": "^2.0",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "SoftDelete\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SoftDelete\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true
        }
    }
}
